# ── Optional Supabase integration ─────────────────────────────────────────────
# The deployed console runs entirely on seeded demo data and needs no
# environment variables. These are the settings the data adapter will read when
# src/lib/workspace-store.tsx is pointed at the live project.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key>
VITE_DATA_MODE=local
