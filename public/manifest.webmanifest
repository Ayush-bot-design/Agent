    {
      "src": "/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "/app-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
